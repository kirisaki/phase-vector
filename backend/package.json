{
  "name": "phase-vector-feedback",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --env '' --outdir dist",
    "test": "npm run check && npm run build && npm run viewer:build && node --test test/*.test.mjs",
    "viewer:build": "wrangler deploy --config viewer/wrangler.jsonc --dry-run --env '' --outdir ../dist/viewer",
    "viewer:dev": "wrangler dev --config viewer/wrangler.jsonc --ip 127.0.0.1 --port 8788 --persist-to .wrangler/state",
    "viewer:deploy": "wrangler deploy --config viewer/wrangler.jsonc --env production",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "deploy": "wrangler deploy --env production"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261124.1",
    "miniflare": "5.20261123.0-beta",
    "typescript": "7.0.2",
    "wrangler": "4.167.0"
  }
}
