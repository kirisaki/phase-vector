{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "phase-vector-feedback-viewer-local",
  "main": "index.ts",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "observability": { "enabled": false },
  "access": { "dev": { "aud": "viewer-local", "identity": { "email": "viewer@example.test" } } },
  "vars": { "VIEWER_EMAILS": "viewer@example.test" },
  "d1_databases": [{ "binding": "DB", "database_name": "feedback", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../migrations" }],
  "r2_buckets": [{ "binding": "SCREENSHOTS", "bucket_name": "phase-vector-feedback-screenshots-local" }],
  "env": {
    "production": {
      "name": "phase-vector-feedback-viewer",
      "vars": {},
      "d1_databases": [{ "binding": "DB", "database_name": "phase-vector-feedback", "database_id": "0adf5ecc-a85c-415f-8125-96aa7d2aefc8" }],
      "r2_buckets": [{ "binding": "SCREENSHOTS", "bucket_name": "phase-vector-feedback" }]
    }
  }
}
