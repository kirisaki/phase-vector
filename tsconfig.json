{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "noEmitOnError": true,
    "rootDir": "web",
    "rootDirs": [
      "web",
      "dist"
    ],
    "types": [],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "web/**/*.ts"
  ]
}
